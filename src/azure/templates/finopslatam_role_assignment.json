{
  "$schema": "https://schema.management.azure.com/schemas/2019-08-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "principalId": {
      "type": "string",
      "metadata": {
        "description": "Object ID del Service Principal de FinOpsLatam (Aplicaciones empresariales > FinOpsLatam-Audit > Id. de objeto). No es el Id. de aplicación (cliente)."
      }
    }
  },
  "variables": {
    "readerRoleDefinitionId": "acdd72a7-3385-48ef-bd42-f606fba81ae7"
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(subscription().id, parameters('principalId'), variables('readerRoleDefinitionId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('readerRoleDefinitionId'))]",
        "principalId": "[parameters('principalId')]",
        "principalType": "ServicePrincipal",
        "description": "Acceso de solo lectura (Reader) para la plataforma FinOpsLatam."
      }
    }
  ],
  "outputs": {
    "roleAssignmentName": {
      "type": "string",
      "value": "[guid(subscription().id, parameters('principalId'), variables('readerRoleDefinitionId'))]"
    }
  }
}
