APP_ENV=dev
FLASK_ENV=development
SQLALCHEMY_DATABASE_URI=postgresql://user:pass@localhost:5432/finops_dev
JWT_SECRET_KEY=dev-secret-change-me
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUIRE_PROD_DB_CHECK=false
MAX_CONTENT_LENGTH_BYTES=65536

# HTTP hardening
TRUST_PROXY_HEADERS=true
ENFORCE_ALLOWED_HOSTS=false
ALLOWED_HOSTS=api.finopslatam.com,localhost,127.0.0.1

# Rate limiting
RATE_LIMIT_API_PER_MINUTE=300
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_FAILED_WINDOW_SECONDS=900
FORGOT_PASSWORD_MAX_ATTEMPTS=5
FORGOT_PASSWORD_WINDOW_SECONDS=900

# Mercado Pago webhook token (opcional pero recomendado)
MP_WEBHOOK_TOKEN=replace-with-random-token

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_FOUNDATION=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_PRICE_CONSULTORIA=price_...

# Frontend URL (para success/cancel de Stripe)
FRONTEND_URL=http://localhost:3000
